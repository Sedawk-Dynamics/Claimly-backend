# Database Configuration
# For production, ensure SSL is enabled: postgresql://user:password@host:5432/claimly?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/claimly"

# JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MUST be at least 32 characters in production
JWT_SECRET="your_strong_jwt_secret_minimum_32_characters"

# Firebase Admin SDK Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration (OPTIONAL - not enforced)
# Note: CORS is open to all origins (web and mobile apps)
# This variable is kept for reference but not used
# CORS_ORIGIN="http://localhost:5175,http://localhost:5173"

# Security Configuration
# Set to true in production to disable test authentication endpoints
DISABLE_TEST_AUTH=false

# Razorpay Configuration (optional, required if using payment features)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
