// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  BigInt     @id @default(autoincrement())
  name                String
  dob                 DateTime?
  email               String?    @unique
  mobile_number       String     @unique
  firebase_id         String     @unique
  device_id           String?
  subscription_status SubscriptionStatus @default(INACTIVE)
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  subscriptions       Subscription[]
  policies            Policy[]
  nominees            Nominee[]
  documents           UserDocument[]
  deceased_alerts     DeceasedAlert[]
  admin_actions       AdminAction[]
  activity_logs       UserActivityLog[]
}

model Subscription {
  id               BigInt     @id @default(autoincrement())
  user_id          BigInt
  plan_name        String
  amount           Decimal    @db.Decimal(10,2)
  payment_id       String
  payment_status   PaymentStatus
  transaction_date DateTime

  user             User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model InsuranceCompany {
  id             BigInt     @id @default(autoincrement())
  name           String
  contact_email  String?
  contact_number String?
  website_url    String?
  address        String?
  status         RecordStatus @default(ACTIVE)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  policies       Policy[]
}

model Policy {
  id                    BigInt     @id @default(autoincrement())
  user_id               BigInt
  insurance_company_id  BigInt
  policy_number         String     @unique
  sum_assured           Decimal    @db.Decimal(13,2)
  status                RecordStatus @default(ACTIVE)
  uploaded_at           DateTime   @default(now())

  user                  User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  insurance_company     InsuranceCompany @relation(fields: [insurance_company_id], references: [id])
  policy_nominees       PolicyNominee[]
  documents             PolicyDocument[]
}

model Nominee {
  id            BigInt     @id @default(autoincrement())
  user_id       BigInt
  name          String
  relationship  Relationship
  mobile_number String
  email         String?
  address       String?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  user          User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  policy_links  PolicyNominee[]
  documents     NomineeDocument[]
}

model PolicyNominee {
  id              BigInt     @id @default(autoincrement())
  policy_id       BigInt
  nominee_id      BigInt
  share_percentage Decimal    @db.Decimal(5,2)
  created_at      DateTime   @default(now())

  policy          Policy     @relation(fields: [policy_id], references: [id], onDelete: Cascade)
  nominee         Nominee    @relation(fields: [nominee_id], references: [id], onDelete: Cascade)
}

model UserDocument {
  id              BigInt     @id @default(autoincrement())
  user_id         BigInt
  document_type   UserDocumentType
  document_name   String
  document_url    String
  is_verified     Boolean    @default(false)
  uploaded_at     DateTime   @default(now())
  verified_at     DateTime?
  rejected_at     DateTime?

  user            User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model PolicyDocument {
  id              BigInt     @id @default(autoincrement())
  policy_id       BigInt
  document_type   PolicyDocumentType
  document_name   String
  document_url    String
  is_verified     Boolean    @default(false)
  uploaded_at     DateTime   @default(now())
  verified_at     DateTime?
  rejected_at     DateTime?

  policy          Policy     @relation(fields: [policy_id], references: [id], onDelete: Cascade)
}

model NomineeDocument {
  id              BigInt     @id @default(autoincrement())
  nominee_id      BigInt
  document_type   NomineeDocumentType
  document_name   String
  document_url    String
  is_verified     Boolean    @default(false)
  uploaded_at     DateTime   @default(now())
  verified_at     DateTime?

  nominee         Nominee    @relation(fields: [nominee_id], references: [id], onDelete: Cascade)
}

model DeceasedAlert {
  id                  BigInt     @id @default(autoincrement())
  user_id             BigInt
  detected_via        DetectionMethod
  detection_date      DateTime
  verification_status VerificationStatus @default(PENDING)
  verified_by         BigInt?
  remarks             String?
  created_at          DateTime   @default(now())

  user                User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  verified_admin      Admin?     @relation(fields: [verified_by], references: [id])
}

model AdminAction {
  id          BigInt     @id @default(autoincrement())
  admin_id    BigInt
  user_id     BigInt
  action_type String
  notes       String?
  created_at  DateTime   @default(now())

  admin       Admin      @relation(fields: [admin_id], references: [id])
  user        User       @relation(fields: [user_id], references: [id])
}

model Admin {
  id            BigInt     @id @default(autoincrement())
  name          String
  email         String     @unique
  password_hash String
  role          AdminRole  @default(STAFF)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  admin_actions AdminAction[]
  verified_alerts DeceasedAlert[]
}

model UserActivityLog {
  id          BigInt     @id @default(autoincrement())
  user_id     BigInt
  activity_type String
  description String?
  metadata    String?    @db.Text
  created_at  DateTime   @default(now())

  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// ===== ENUMS =====

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum Relationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  FRIEND
  OTHER
}

enum UserDocumentType {
  AADHAAR
  PAN
  OTHER
}

enum PolicyDocumentType {
  POLICY_COPY
  RECEIPT
  OTHER
}

enum NomineeDocumentType {
  NOMINEE_ID
  ADDRESS_PROOF
  DEATH_CERTIFICATE
  OTHER
}

enum DetectionMethod {
  SMS
  MANUAL
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FALSE_ALERT
}

enum AdminRole {
  SUPER_ADMIN
  STAFF
}
